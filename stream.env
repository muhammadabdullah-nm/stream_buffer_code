class stream_env extends uvm_env;
  `uvm_component_utils(stream_env)

  wr_agent          wr_agt;
  rd_agent          rd_agt;
  stream_scoreboard sb;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    wr_agt = wr_agent         ::type_id::create("wr_agt", this);
    rd_agt = rd_agent         ::type_id::create("rd_agt", this);
    sb     = stream_scoreboard::type_id::create("sb",     this);
  endfunction

  function void connect_phase(uvm_phase phase);
    wr_agt.mon.ap.connect(sb.wr_imp);
    rd_agt.mon.ap.connect(sb.rd_imp);
  endfunction
endclass